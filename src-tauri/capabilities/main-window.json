{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the local PAM main window to invoke bounded PAM commands and synchronize native appearance.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap",
    "allow-catalog",
    "allow-activate-project",
    "allow-refresh-project",
    "allow-start-daemon",
    "allow-stop-daemon",
    "allow-register-gui-caller",
    "allow-decide-approval",
    "allow-load-evidence",
    "allow-load-flow-workspace",
    "allow-daemon-activity",
    "allow-daemon-logs",
    "allow-daemon-stats",
    "allow-caller-registry",
    "allow-daemon-access",
    "allow-daemon-access-config",
    "allow-set-daemon-access",
    "allow-model-status",
    "allow-model-infer",
    "allow-model-import",
    "allow-model-import-status",
    "allow-model-inspect",
    "allow-model-license-discover",
    "allow-model-presets",
    "allow-model-download",
    "allow-model-download-status",
    "allow-model-download-cancel",
    "allow-host-memory",
    "allow-app-settings",
    "allow-settings-update",
    "allow-logs-delete",
    "allow-reveal-path",
    "allow-flow-graph",
    "allow-flow-compose",
    "allow-load-skill-inventory",
    "allow-manage-skill-library",
    "allow-load-skill-audit",
    "allow-run-skill-audit",
    "allow-open-flow",
    "allow-validate-flow",
    "allow-save-flow",
    "allow-connector-registry",
    "allow-connector-configure",
    "allow-connector-test",
    "allow-daemon-health",
    "core:app:allow-set-app-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open"
  ]
}
